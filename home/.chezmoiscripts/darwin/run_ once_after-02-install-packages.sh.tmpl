{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/sh

# Install common macOS packages

source /tmp/chezmoi-utils.sh

printf "${green}[02 - Brew Packages] ${reset}"
{{- if or (lt 02 (atoi (env "SCRIPTS_START_AT"))) (env "SKIP_BREW") }}
echo "Skip installing common macOS packages"
exit 0
{{ else }}
echo "Install common macOS packages"
{{- end }}

set -eufo pipefail

# Ensure we're using ARM64 Homebrew context on Apple Silicon
if [[ "$(uname -m)" == "arm64" ]]; then
  # Apple Silicon - use ARM64 Homebrew
  if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
else
  # Intel Mac - use x86_64 Homebrew
  if [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

{{ $taps := list
  "github/gh"
  "oven-sh/bun"
  "weaveworks/tap"
  "basicmachines-co/basic-memory"
-}}

{{ $brews := list
