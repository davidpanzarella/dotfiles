# .zshrc is sourced in interactive shells.
# It should contain commands to set up aliases, functions, options, key bindings, etc.
# https://unix.stackexchange.com/questions/71253/what-should-shouldnt-go-in-zshenv-zshrc-zlogin-zprofile-zlogout
# https://www.youtube.com/watch?v=MSPu-lYF-A8

# 1) Only interactive shells run the rest
[[ -o interactive ]] || return

# 2) Cursor/VS Code shell integration (don't move below prompt/plugins)
if [[ -n "$VSCODE_SHELL_INTEGRATION" && -r "$VSCODE_SHELL_INTEGRATION" ]]; then
  . "$VSCODE_SHELL_INTEGRATION"
fi

# 3) Don't clobber preexec/precmd — append hooks instead of overwriting
autoload -Uz add-zsh-hook

# 4) Initialize completion system
autoload -Uz compinit
# Only run compinit once per day for performance
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# 5) Tooling (mise) – keep light
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh --quiet)"
fi

# 6) Initialize Starship prompt (works in all terminals)
if command -v starship &> /dev/null; then
  eval "$(starship init zsh --print-full-init)"
fi

# History configuration - preserve your command history!
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# History options (quiet)
setopt appendhistory sharehistory incappendhistory
setopt histignoredups histignorespace extendedhistory

# some useful options (man zshoptions)
setopt autocd extendedglob nomatch menucomplete
setopt interactive_comments

# beeping is annoying
unsetopt BEEP



# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# No theme needed - starship handles the prompt
ZSH_THEME=""

# FZF configurations - Enhanced fuzzy finding
export FZF_DEFAULT_OPTS='
  --height 40% 
  --layout=reverse 
  --border 
  --preview-window=right:60%:wrap
  --bind ctrl-u:preview-page-up,ctrl-d:preview-page-down
  --color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9
  --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9
  --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6
  --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4'

# Use fd for FZF (faster than find)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Enhanced ripgrep integration with FZF
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window up:3:hidden:wrap --bind '?:toggle-preview'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

# FZF preview commands
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

# FZF-tab configurations
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format ' %F{yellow}-- %d --%f'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons $realpath'
zstyle ':fzf-tab:complete:*:*' fzf-preview 'less ${(Q)realpath}'
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# Enhanced FZF-tab previews for modern tools
zstyle ':fzf-tab:complete:rg:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:fd:*' fzf-preview 'if [[ -d $realpath ]]; then eza --tree --color=always $realpath | head -200; else bat --color=always --style=numbers --line-range=:500 $realpath; fi'
zstyle ':fzf-tab:complete:bat:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:eza:*' fzf-preview 'if [[ -d $realpath ]]; then eza --tree --color=always $realpath | head -200; else bat --color=always --style=numbers --line-range=:500 $realpath; fi'

# FZF-tab description display
zstyle ':fzf-tab:*' show-group full
zstyle ':fzf-tab:*' fzf-bindings 'tab:accept'
zstyle ':fzf-tab:*' fzf-flags '--preview-window=right:60%:wrap'

# FZF-tab: Show descriptions in the right panel
zstyle ':fzf-tab:complete:*' fzf-preview 'echo $desc'
zstyle ':fzf-tab:complete:*' fzf-flags '--preview-window=right:60%:wrap'
zstyle ':fzf-tab:complete:*' fzf-preview 'echo "Description: $desc"'

# Which plugins would you like to load? (plugins can be found in ~/.dotfiles/oh-my-zsh/plugins/*)
plugins=(
  # Core productivity plugins
  1password               # 1Password CLI integration
  aliases                 # Alias management
  brew                    # Homebrew aliases and completions
  colored-man-pages       # Colorized man pages
  command-not-found       # Suggests packages for missing commands
  common-aliases          # Common useful aliases
  
  # Clipboard and file operations
  copybuffer              # Copy current command line to clipboard
  copyfile                # Copy file contents to clipboard
  copypath                # Copy current path to clipboard
  cp                      # Enhanced cp with progress (cpv function)
  extract                 # Universal archive extractor (x command)
  
  # Directory and navigation
  dirhistory              # Navigate directory history with Alt+arrows
  dirpersist              # Restore directory stack between sessions
  pj                      # Project jump - quick project navigation
  z                       # Smart directory jumping (until zoxide fully replaces)
  
  # Development tools
  docker                  # Docker aliases and completions
  docker-compose          # Docker Compose aliases
  dotenv                  # Auto-load .env files
  gh                      # GitHub CLI completions
  git                     # Git aliases and completions
  jsontools               # JSON manipulation tools
  kubectl                 # Kubernetes aliases and completions
  node                    # Node.js completions
  npm                     # NPM completions and aliases
  pip                     # Python pip completions
  python                  # Python completions
  yarn                    # Yarn completions and aliases
  vscode                  # VS Code integration
  
  # Search and fuzzy finding
  fzf                     # Fuzzy finder integration
  fzf-tab                 # Replace tab completion with fzf
  history-substring-search # Search history with up/down arrows
  web-search              # Search web from command line
  
  # System and utilities
  emoji                   # Emoji completion
  macos                   # macOS-specific aliases and functions
  safe-paste              # Safe pasting of multi-line commands
  sudo                    # Sudo aliases and completions
  
  # Enhanced shell experience (keep these last)
  zsh-autosuggestions     # Fish-like autosuggestions
)



# Load oh-my-zsh (quiet)
source $ZSH/oh-my-zsh.sh 2>/dev/null

# Modern tool alternatives (in addition to Oh My Zsh plugins)
# zoxide - faster, more accurate directory jumping (can replace z plugin)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
  # Keep z plugin for now, but zoxide is available as alternative
fi

# direnv - environment management (can replace dotenv plugin)
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
  # Keep dotenv plugin for now, but direnv is available as alternative
fi

# Ensure completion system is properly initialized after oh-my-zsh
# This fixes issues where completions don't work properly
if command -v compdef >/dev/null 2>&1; then
  # Re-initialize completion system to ensure all completions are loaded
  compinit -D
fi

# Load functions and aliases after oh-my-zsh
source "$ZDOTDIR/zsh-functions"
zsh_add_file "zsh-aliases"

# Load direnv if available (quiet)
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)" 2>/dev/null
fi


# Add flags to existing aliases.
alias ls="${aliases[ls]:-ls} -A"

# Modern tool aliases (enhanced versions of common commands)
alias ll='eza -la --icons --git --group-directories-first'
alias la='eza -la --icons --group-directories-first'
alias lt='eza --tree --level=2 --icons --git'
alias lta='eza --tree --level=3 --icons --git --all'
alias cat='bat --paging=never'
alias grep='rg --smart-case'
alias find='fd'
alias ps='procs'

# Enhanced git aliases with delta
alias gd='git diff --color-words'
alias gds='git diff --staged --color-words'
alias gl='git log --oneline --graph --decorate --all'
alias gla='git log --oneline --graph --decorate --all --stat'

# Git delta configuration (if delta is available)
if command -v delta &> /dev/null; then
  export GIT_PAGER="delta"
  export DELTA_PAGER="less -R"
fi

# Directory navigation enhancements
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# Quick project navigation (if you have common project directories)
alias proj='cd ~/Projects'
alias docs='cd ~/Documents'
alias dl='cd ~/Downloads'

# Set shell options: http://zsh.sourceforge.net/Doc/Release/Options.html.
# Awesome cd movements from zshkit
setopt autocd autopushd pushdminus pushdsilent pushdtohome cdablevars
DIRSTACKSIZE=5

# Shell options
ulimit -n 8192
unsetopt nomatch
setopt auto_cd
setopt extendedglob  # enable extended globbing
setopt glob_dots     # no special treatment for file names with a leading dot
setopt interactive_comments
setopt no_auto_menu  # require an extra TAB press to open the completion menu

# Zoxide - Smart directory jumping (quiet)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)" 2>/dev/null
fi

# Hybrid history setup - best of both worlds!
if command -v atuin &> /dev/null; then
  # Initialize atuin but don't bind to up arrow by default (quiet)
  eval "$(atuin init zsh --disable-up-arrow)" 2>/dev/null
  
  # Atuin keybindings for advanced search:
  # Ctrl+R - Atuin's fuzzy search with app context
  # Ctrl+S - Atuin's session-based search
  bindkey '^r' _atuin_search_widget
fi

# Traditional history search with up/down arrows (familiar behavior)
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search    # Up arrow - traditional
bindkey "^[[B" down-line-or-beginning-search  # Down arrow - traditional

# FZF keybindings - Enhanced directory navigation
# Note: FZF widgets are loaded by Oh My Zsh fzf plugin
bindkey "^[c" fzf-cd-widget                    # Alt+C for directory search
bindkey "^T" fzf-file-widget                   # Ctrl+T for file search

# pnpm
export PNPM_HOME="{{ .chezmoi.homeDir }}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# pnpm shell completion
if [ -f "/opt/homebrew/share/zsh/site-functions/_pnpm" ]; then
  source "/opt/homebrew/share/zsh/site-functions/_pnpm"
fi

# Tab completion is handled automatically by:
# 1. Oh-My-Zsh plugins (git, brew, npm, docker, kubectl, gh, etc.)
# 2. Homebrew completions (pnpm, etc.)
# 3. Built-in zsh completions
# 4. fzf-tab plugin for enhanced completion experience

# For custom commands, they can define their own completions
# or use the built-in help system for discovery

# Simple helper function for command discovery
help-cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    "$1" --help 2>/dev/null || "$1" help 2>/dev/null || echo "No help available for $1"
  else
    echo "Command $1 not found"
  fi
}

# Enhanced search functions
search-code() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: search-code <pattern> [directory]"
    return 1
  fi
  local pattern="$1"
  local dir="${2:-.}"
  rg --smart-case --type-not=minified --type-not=lock "$pattern" "$dir"
}

search-files() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: search-files <pattern> [directory]"
    return 1
  fi
  local pattern="$1"
  local dir="${2:-.}"
  fd --type f --smart-case "$pattern" "$dir"
}

# Quick directory operations
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Enhanced file operations
cpv() {
  rsync -avh --progress "$@"
}

# Git workflow helpers
gco() {
  if [[ $# -eq 0 ]]; then
    git branch | fzf | xargs git checkout
  else
    git checkout "$@"
  fi
}

gcb() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: gcb <branch-name>"
    return 1
  fi
  git checkout -b "$1"
}

# Docker helpers
dps() {
  docker ps --format "table {{`{{.Names}}`}}\t{{`{{.Image}}`}}\t{{`{{.Status}}`}}\t{{`{{.Ports}}`}}"
}

# System information
sysinfo() {
  echo "=== System Information ==="
  echo "OS: $(uname -s) $(uname -r)"
  echo "Shell: $SHELL"
  echo "Architecture: $(uname -m)"
  echo "Homebrew: $(brew --version 2>/dev/null | head -1 || echo 'Not installed')"
  echo "Node: $(node --version 2>/dev/null || echo 'Not installed')"
  echo "Python: $(python3 --version 2>/dev/null || echo 'Not installed')"
  echo "Git: $(git --version 2>/dev/null || echo 'Not installed')"
}

# Custom completion for mem command
_mem() {
  local -a commands
  commands=(
    '--help:Show comprehensive help documentation'
    '-h:Show comprehensive help documentation'
    'backfill:Comprehensive backfill of all historical conversations'
    'check-github:Check GitHub integration status'
    'create-adr:Create a new Architecture Decision Record'
    'create-template:Create a file from a template'
    'export-all:Export all conversations for current project'
    'export-conversation:Show instructions for exporting conversations'
    'export-latest:Export latest Cursor conversation'
    'export-missing:Export only missing conversations (safe for existing projects)'
    'extract-decisions:Extract decisions from conversations'
    'extract-knowledge:Extract knowledge from conversation file'
    'help:Show comprehensive help documentation'
    'list:List items by type'
    'move-exported:Move exported conversation to memories directory'
    'process-daily:Process daily notes (analyze content)'
    'save-conversation:Save a new conversation' 
    'search:Search across all memories'
    'setup-memory:Set up a new memory system for a project'
    'setup-project-memory:Set up memory system for an existing project'
  )
  _describe 'mem commands' commands
}

# FZF-tab: Hide preview for commands, keep for files
zstyle ':fzf-tab:complete:*:*' fzf-flags '--preview-window=hidden'

# Keep preview for file-related completions
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons $realpath'
zstyle ':fzf-tab:complete:ls:*' fzf-preview 'eza -1 --color=always --icons $realpath'
zstyle ':fzf-tab:complete:cat:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:less:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:head:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:tail:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:grep:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:rg:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:code:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:vim:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'
zstyle ':fzf-tab:complete:nano:*' fzf-preview 'bat --color=always --style=numbers --line-range=:500 $realpath'

# File operations with directory preview
zstyle ':fzf-tab:complete:cp:*' fzf-preview 'if [[ -d $realpath ]]; then eza --tree --color=always $realpath | head -200; else bat --color=always --style=numbers --line-range=:500 $realpath; fi'
zstyle ':fzf-tab:complete:mv:*' fzf-preview 'if [[ -d $realpath ]]; then eza --tree --color=always $realpath | head -200; else bat --color=always --style=numbers --line-range=:500 $realpath; fi'
zstyle ':fzf-tab:complete:rm:*' fzf-preview 'if [[ -d $realpath ]]; then eza --tree --color=always $realpath | head -200; else bat --color=always --style=numbers --line-range=:500 $realpath; fi'

# Git operations
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'git log --oneline --graph --color=always $realpath'
zstyle ':fzf-tab:complete:git-add:*' fzf-preview 'git diff --color=always $realpath'
zstyle ':fzf-tab:complete:git-diff:*' fzf-preview 'git diff --color=always $realpath'
zstyle ':fzf-tab:complete:git-show:*' fzf-preview 'git show --color=always $realpath'

# Enable preview for file completions
zstyle ':fzf-tab:complete:*:*' fzf-flags '--preview-window=right:60%:wrap' '--preview-window=hidden'

# Register completion function when completion system is available
if command -v compdef >/dev/null 2>&1; then
  compdef _mem mem
fi

# Terminal-specific integrations
if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
  # Load iTerm2 shell integration only when using iTerm2
  test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
fi

# Ensure /opt/homebrew/bin is prioritized over /usr/local/bin
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Add ~/.local/bin to PATH for user-installed binaries
export PATH="$HOME/.local/bin:$PATH"

# Add Docker CLI to PATH (Docker Desktop)
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"

# Enhanced tool configurations
export BAT_THEME="Dracula"  # or "TwoDark", "Monokai", etc.
export BAT_STYLE="numbers,changes,header"
export EZA_ICON_SPACING=2
export EZA_COLORS="da=1;34:di=1;34:ex=1;32:fi=0:ln=1;36:or=1;31:pi=1;33:so=1;35:st=1;33:su=1;31:tw=1;34"

# Ripgrep configuration
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# FZF configuration for better performance
export FZF_COMPLETION_TRIGGER='**'
export FZF_COMPLETION_OPTS='--border --info=inline'

# Zoxide configuration
export _ZO_DATA_DIR="$HOME/.local/share/zoxide"
export _ZO_ECHO=1
export _ZO_EXCLUDE_DIRS="$HOME/.git"
